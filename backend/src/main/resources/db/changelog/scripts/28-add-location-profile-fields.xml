<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

    <changeSet author="lissz" id="28-add-location-profile-fields">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="locations"/>
            <not>
                <columnExists tableName="locations" columnName="description"/>
            </not>
        </preConditions>
        <addColumn tableName="locations">
            <column name="description" type="TEXT"/>
            <column name="year_established" type="INT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
