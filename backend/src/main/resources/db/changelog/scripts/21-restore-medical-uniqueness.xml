<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="21-restore-medical-uniqueness" author="lissz">
        <addColumn tableName="patients">
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <addColumn tableName="doctors">
            <column name="deleted" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <sql dbms="postgresql">
            CREATE UNIQUE INDEX idx_patients_pesel_active ON patients(pesel_hash) WHERE deleted = false;
            CREATE UNIQUE INDEX idx_doctors_pwz_active ON doctors(pwz) WHERE deleted = false;
        </sql>
    </changeSet>

</databaseChangeLog>