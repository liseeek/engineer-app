<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.9.xsd">

    <changeSet id="25-doctor-location-requests" author="lissz">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="doctor_location_requests"/>
            </not>
        </preConditions>

        <createTable tableName="doctor_location_requests">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="doctor_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="location_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(32)">
                <constraints nullable="false"/>
            </column>
            <column name="requested_by" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="doctor_location_requests"
                                 baseColumnNames="doctor_id"
                                 referencedTableName="doctors"
                                 referencedColumnNames="user_id"
                                 constraintName="fk_dlr_doctor"/>

        <addForeignKeyConstraint baseTableName="doctor_location_requests"
                                 baseColumnNames="location_id"
                                 referencedTableName="locations"
                                 referencedColumnNames="location_id"
                                 constraintName="fk_dlr_location"/>

        <addForeignKeyConstraint baseTableName="doctor_location_requests"
                                 baseColumnNames="requested_by"
                                 referencedTableName="users"
                                 referencedColumnNames="user_id"
                                 constraintName="fk_dlr_requested_by"/>

        <sql dbms="postgresql">
            CREATE UNIQUE INDEX uq_dlr_pending_doctor_location
            ON doctor_location_requests (doctor_id, location_id)
            WHERE status = 'PENDING';
        </sql>
    </changeSet>
</databaseChangeLog>
