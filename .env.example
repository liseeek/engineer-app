POSTGRES_DB=med-hub-db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
DB_USERNAME=postgres
DB_PASSWORD=password
ADMIN_PASSWORD=admin_secure_password
JWT_SECRET_KEY=REPLACE_WITH_YOUR_BASE64_SECRET
CORS_ALLOWED_ORIGINS=http://localhost:3000
ENCRYPTION_KEY=REPLACE_WITH_32_CHAR_AES_KEY
HASHING_SALT=REPLACE_WITH_SECURE_SALT

MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@medhub.local
FRONTEND_BASE_URL=http://localhost:3000
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true

# Doctor self-signup (POST /v1/doctors/signup). Default in application.yaml is false — safer on a public host.
# For local/docker demo, use true (docker-compose defaults to true for backend + frontend build).
MEDHUB_DOCTOR_SELF_SIGNUP_ENABLED=false

# Max upcoming appointments (today or later, ACTIVE/RESCHEDULED) per patient — limits joke-booking spam.
MEDHUB_APPOINTMENTS_MAX_UPCOMING_PER_PATIENT=5

# Frontend build-time: show doctor registration link on login (must match backend when enabling signup).
# When using docker-compose, default is true; for production-style image build set to false.
REACT_APP_DOCTOR_SIGNUP_ENABLED=false

# AI Smart Assistant (Gemini). Get your free key at https://aistudio.google.com/apikey
# Model id must match the API exactly (see https://ai.google.dev/gemini-api/docs/models), e.g. gemini-2.5-flash — not a short name like "2.5-flash".
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
MEDHUB_AI_ENABLED=true

# Optional: disable Swagger/OpenAPI on a public host (defaults in application.yaml are enabled for local dev).
# SPRINGDOC_API_DOCS_ENABLED=false
# SPRINGDOC_SWAGGER_UI_ENABLED=false